# =====================================================================
# Copy this file to  .env  and fill in your real values.
#   .env        is gitignored. Never commit it.
#   .env.example is committed and contains no secrets.
#
# Where to find the database values:
#   Supabase -> Connect -> Connection string
#   Use the SESSION POOLER, not the direct connection.
# =====================================================================

# Host, username and password are deliberately on SEPARATE lines.
# The Supabase UI gives you one URI with the password embedded, but a
# password containing @ : / # ? then breaks the URL unless it is
# percent-encoded. Keeping it separate means no escaping is ever needed.
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_USERNAME=postgres.PROJECTREF
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# ---------------------------------------------------------------------
# JWT signing secret.
#
# MUST be at least 32 bytes — the app refuses to start otherwise, which
# is deliberate. HS256 needs a 256-bit key, and silently accepting a
# short one would ship a token anyone could brute-force.
#
# Generate one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#
# Never reuse this value across environments. Rotating it invalidates
# every outstanding token, which is the correct behaviour on compromise.
# ---------------------------------------------------------------------
JWT_SECRET=replace-with-at-least-32-random-bytes-of-base64-text-here

# ---------------------------------------------------------------------
# Optional. Set to "debug" to print every SQL statement and its bound
# parameters. Local debugging only — bound parameters contain user data.
# ---------------------------------------------------------------------
# SQL_LOGGING=debug