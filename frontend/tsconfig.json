{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* JSX.
       "react-jsx" is the automatic runtime: it compiles <div> to an
       import from react/jsx-runtime, so every file does NOT need
       `import React from 'react'`. The old "react" setting requires
       React in scope in every single file. */
    "jsx": "react-jsx",

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,

    /* Strictness.
       The Vite template ships with strict OFF, which defeats most of the
       point of using TypeScript. A response shape change should be a
       compile error, not a blank screen in production. */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "vite.config.ts"]
}